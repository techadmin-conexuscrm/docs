<?xml version="1.0"?>
<!-- LAB ONLY. The "far end": stands in for Kamailio + the PSTN (the customer's
     phone, a voicemail box) and the agent's phone. Same image as the FreeSWITCH
     under test, this minimal config instead of the repo's. It answers the
     calls the lab FreeSWITCH places through its "kamailio" gateway:
       play_<file>[__tag]   answer, play /lab/audio/far/<file>.wav, then listen
       cust[_tag]           answer, loop the customer's voice (keypad digits are
                            sent from the lab runner with uuid_send_dtmf)
       agent[_tag]          answer, loop the agent's voice
     and records everything it hears under /results/far-rec/. -->
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="set" data="lab_net=10.88.231.0/24"/>
  <section name="configuration" description="lab far end">
    <configuration name="switch.conf">
      <settings>
        <param name="loglevel" value="info"/>
        <param name="rtp-start-port" value="20000"/>
        <param name="rtp-end-port" value="20999"/>
        <param name="max-sessions" value="200"/>
        <param name="sessions-per-second" value="50"/>
      </settings>
    </configuration>
    <configuration name="modules.conf">
      <modules>
        <load module="mod_console"/>
        <load module="mod_event_socket"/>
        <load module="mod_sofia"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_sndfile"/>
        <load module="mod_native_file"/>
        <load module="mod_tone_stream"/>
      </modules>
    </configuration>
    <configuration name="console.conf">
      <mappings><map name="all" value="console,info,notice,warning,err,crit,alert"/></mappings>
      <settings><param name="colorize" value="false"/><param name="loglevel" value="info"/></settings>
    </configuration>
    <configuration name="acl.conf">
      <network-lists>
        <list name="lab" default="deny"><node type="allow" cidr="$${lab_net}"/><node type="allow" cidr="127.0.0.0/8"/></list>
      </network-lists>
    </configuration>
    <configuration name="event_socket.conf">
      <settings>
        <param name="listen-ip" value="0.0.0.0"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="lab-far-only"/>
        <param name="apply-inbound-acl" value="lab"/>
      </settings>
    </configuration>
    <configuration name="sofia.conf">
      <global_settings><param name="log-level" value="0"/></global_settings>
      <profiles>
        <profile name="far">
          <settings>
            <param name="sip-ip" value="10.88.231.20"/>
            <param name="rtp-ip" value="10.88.231.20"/>
            <param name="sip-port" value="5060"/>
            <param name="context" value="far"/>
            <param name="dialplan" value="XML"/>
            <param name="auth-calls" value="false"/>
            <param name="apply-inbound-acl" value="lab"/>
            <param name="inbound-codec-prefs" value="PCMU,PCMA"/>
            <param name="outbound-codec-prefs" value="PCMU,PCMA"/>
            <param name="dtmf-type" value="rfc2833"/>
            <param name="rfc2833-pt" value="101"/>
            <param name="rtp-timer-name" value="soft"/>
            <param name="disable-register" value="true"/>
          </settings>
        </profile>
      </profiles>
    </configuration>
  </section>
  <section name="dialplan" description="far end">
    <context name="far">
      <extension name="agent">
        <condition field="destination_number" expression="^agent(_.*)?$">
          <action application="answer"/>
          <action application="set" data="RECORD_STEREO=true"/>
          <action application="record_session" data="/results/far-rec/agent-${uuid}.wav"/>
          <action application="endless_playback" data="/lab/audio/far/agent_voice.wav"/>
        </condition>
      </extension>
      <extension name="cust">
        <condition field="destination_number" expression="^cust(_.*)?$">
          <action application="answer"/>
          <action application="set" data="RECORD_STEREO=true"/>
          <action application="record_session" data="/results/far-rec/cust-${uuid}.wav"/>
          <action application="endless_playback" data="/lab/audio/far/cust_voice.wav"/>
        </condition>
      </extension>
      <extension name="play">
        <condition field="destination_number" expression="^play_([a-z0-9_]+?)(__[A-Za-z0-9_]+)?$">
          <action application="answer"/>
          <action application="set" data="RECORD_STEREO=true"/>
          <action application="record_session" data="/results/far-rec/play-$1$2-${uuid}.wav"/>
          <action application="playback" data="/lab/audio/far/$1.wav"/>
          <action application="sleep" data="30000"/>
          <action application="hangup"/>
        </condition>
      </extension>
    </context>
  </section>
</document>
