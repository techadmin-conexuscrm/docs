diff --git a/autoload_configs/amd.conf.xml b/autoload_configs/amd.conf.xml
new file mode 100644
index 0000000..aee7620
--- /dev/null
+++ b/autoload_configs/amd.conf.xml
@@ -0,0 +1,77 @@
+
+<configuration name="amd.conf" description="mod_amd Configuration">
+  <!--
+    PILOT MODE (the default, approved 2026-10-24): the agent joins at
+    answer and mod_amd only LOGS its verdict; nothing waits on it. What
+    follows is "AMD gates the agent" (conexus_amd_mode=gate, a per-company
+    switch, off), which these numbers were chosen for.
+
+    mod_amd ONLY DECIDES WHO GETS AN AGENT. It never decides whether a
+    recorded message plays: that is the beep's job (mod_avmd, see
+    avmd.conf.xml and scripts/campaign_amd.lua). Research and the sweep
+    behind every number here: docs freeswitch/lab/research/AMD-STRATEGY.md.
+
+      HUMAN or NOTSURE -> an agent at once (a person is the expensive
+                          mistake; an agent hearing a mailbox is the cheap one)
+      MACHINE          -> the voicemail path: hold for a beep (at most 30 s
+                          after answer); no beep -> an agent, never a recording
+
+    Some people and some mailboxes make exactly the same sound ("Hello,
+    yeah?" and a 1.5 s "Please leave a message"), so no setting can call
+    every clip right. These are set so that no person is ever MACHINE in
+    the research corpus (35 clips, each at 6 levels x 3 speeds), with the
+    most room on every dial, and so that long greetings still are.
+
+    How mod_amd decides (webitel/mod_amd 52e6bc6): every 20 ms frame is
+    voice or silence by its average sample level against silence_threshold;
+    voice_duration counts voiced frames and is reset by a pause of
+    between_words_silence; the first rule to trip ends the analysis.
+
+      - between_words_silence=800 (was 250): THE fix. At 250 the ordinary
+        0.3-0.6 s pauses between a greeting's sentences reset
+        voice_duration, so `greeting` only ever measured one sentence and
+        could not tell a mailbox from a person who says one long sentence
+        (D1 and the "greeting cannot fire inside its window" finding are
+        the same fault). At 800 it measures how much talking happens before
+        the first real pause: people stop after a second or three and wait,
+        a mailbox reads its whole script. Safe band 600-1000.
+      - greeting=5000: 5 s of voiced sound with no 0.8 s pause is MACHINE.
+        The most any person in the corpus reached in any variant is 3,860 ms
+        (a slow 4 s talker, slowed and turned up). Safe band 4000-6000.
+      - after_greeting_silence=1200 (was 800): a 1.2 s pause after talk is
+        HUMAN. The 2-second rule (47 CFR 64.1200(a)(7)) counts from the
+        end of the person's greeting, so this plus the bridge must stay
+        under 2 s; 1200 is Twilio's default for the same thing. At 800 a
+        mailbox's pause before its beep read as "a person stopped".
+      - total_analysis_time=12000 (was 7000): long greetings (a carrier's
+        default, a number read out, a real 11 s greeting) reach 5 s of voice
+        at 7.8-10 s; at 7000 every one of them was NOTSURE. A person who
+        never pauses for 1.2 s waits up to this long for an agent; in
+        agent-first dialing (today) the agent is already on the line.
+      - silence_threshold=1024 (was 640): street noise under a talking
+        person, turned up, read as one long greeting at 896 and below.
+        Above 1024 quiet callers vanish. Safe band 1024-1536.
+      - maximum_number_of_words=12 and maximum_word_length=6000: at these
+        settings neither ever decides (kept above greeting); the old
+        maximum_number_of_words=3 called "Hello? ... Hello? ... anyone
+        there?" a MACHINE.
+      - initial_silence=2500, silence_notsure=1: nobody speaks for 2.5 s ->
+        NOTSURE -> an agent (mod_amd's default 0 would make it MACHINE).
+
+    tests/amd_test.py checks these numbers against a port of the pinned
+    mod_amd. Expect on real calls (AMD-STRATEGY.md section 7): measure in
+    shadow mode first; nothing plays by itself until the pilot says so.
+  -->
+  <settings>
+    <param name="silence_threshold" value="1024"/>
+    <param name="maximum_word_length" value="6000"/>
+    <param name="maximum_number_of_words" value="12"/>
+    <param name="between_words_silence" value="800"/>
+    <param name="min_word_length" value="100"/>
+    <param name="total_analysis_time" value="12000"/>
+    <param name="after_greeting_silence" value="1200"/>
+    <param name="greeting" value="5000"/>
+    <param name="initial_silence" value="2500"/>
+    <param name="silence_notsure" value="1"/>
+  </settings>
+</configuration>
diff --git a/autoload_configs/avmd.conf.xml b/autoload_configs/avmd.conf.xml
new file mode 100644
index 0000000..257034e
--- /dev/null
+++ b/autoload_configs/avmd.conf.xml
@@ -0,0 +1,85 @@
+<configuration name="avmd.conf" description="AVMD config">
+	<settings>
+
+	<!-- Edit these settings to change default behaviour
+		 of each avmd session. Settings can be overwritten
+		 by values passed dynamically per each session -->
+
+
+		<!-- Global settings -->
+
+			<!-- define/undefine this to enable/disable logging of avmd
+				 intermediate computations to log -->
+			<param name="debug" value="0"/>
+
+			<!-- define/undef this to enable/disable verbose logging (and reporting to the console)
+				 of detection status and other diagnostics like parameters avmd session has been started with,
+				 change of configuration parameters, beep detection status after session ended
+				 (stop event is fired independently of this setting and beep status included there) -->
+			<param name="report_status" value="1"/>
+
+			<!-- define/undefine this to enable/disable faster computation
+				 of arcus cosine - table will be created mapping floats
+				 to integers and returning arc cos values given these integer
+				 indices into table -->
+			<param name="fast_math" value="0"/>
+		<!-- Global settings end -->
+
+
+		<!-- Per call (session) settings. These settings can be overwritten
+			 with custom/different values per each avmd session -->
+
+			<!-- define/undefine this to classify avmd beep detection as valid
+				 only when there is required number of consecutive elements
+				 in the SMA buffer without reset -->
+			<param name="require_continuous_streak" value="1"/>
+
+			<!-- required number of consecutive elements in the SMA buffer
+				 without reset. This parameter helps to avoid false beeps, bigger this value is
+				smaller the probability of getting false detection -->
+			<!-- 8, not 3: the beep alone decides whether a recorded message
+				 plays (scripts/campaign_amd.lua), so a false beep is a
+				 recording played to a person. At 3 avmd heard a "beep" in a
+				 person's speech over street noise (3 of 54 runs); at 5, 8
+				 and 12 never (0 of 1,134 runs plus 3 minutes of real speech),
+				 and 8 still hears every real beep in the research corpus
+				 (648/648; 12 starts missing them). docs
+				 freeswitch/lab/research/AMD-STRATEGY.md section 6. Known
+				 limits at any streak: no beep is heard on a line with a
+				 modest noise floor, a 2000 Hz beep is never heard, a 440 Hz
+				 one rarely; those mailboxes go to an agent. -->
+			<param name="sample_n_continuous_streak" value="8"/>
+
+			<!-- define number of samples to skip starting from the beginning
+				 of the frame and/or after reset  has happened. This serves the purpose of skipping first few
+				estimations on each frame, as these estimations may be inaccurate. This parameter also helps
+				to give more robust detections when it's value is increased (up to scertain limit of about 60). -->
+			<param name="sample_n_to_skip" value="0"/>
+
+			<param name="require_continuous_streak_amp" value="1"/>
+			<param name="sample_n_continuous_streak_amp" value="8"/>
+
+			<!-- define/undefine this to enable/disable simplified estimation
+				 of frequency based on approximation of sin(x) with (x)
+				 in the range x=[0,PI/2] -->
+			<param name="simplified_estimation" value="1"/>
+
+			<!-- define/undefine to enable/disable avmd on internal channel -->
+			<param name="inbound_channel" value="0"/>
+
+			<!-- define/undefine to enable/disable avmd on external channel -->
+			<param name="outbound_channel" value="1"/>
+
+			<!-- determines the mode of detection, default is both amplitude and frequency -->
+			<param name="detection_mode" value="2"/>
+
+			<!-- number of detection threads running per each avmd session -->
+			<param name="detectors_n" value="36"/>
+
+			<!-- number of lagged detection threads running per each avmd session -->
+			<param name="detectors_lagged_n" value="1"/>
+
+		<!-- Per call settings end -->
+	</settings>
+</configuration>
+
diff --git a/autoload_configs/httapi.conf.xml b/autoload_configs/httapi.conf.xml
new file mode 100644
index 0000000..02e4a5d
--- /dev/null
+++ b/autoload_configs/httapi.conf.xml
@@ -0,0 +1,53 @@
+<configuration name="httapi.conf" description="mod_httapi: only its http(s):// file cache is used">
+  <!--
+    modules.conf.xml loads mod_httapi, but without this file it does not load
+    ("open of httapi.conf failed"), and `playback:https://...` then fails with
+    FILE NOT FOUND. That is how the campaign voicemail drop (BE-17) plays its
+    5-minute recording link. Lab: section 4, be17https.
+
+    Only the file cache is used here (playback of http:// and https:// URLs).
+    The HTTAPI dialplan application is not: the one profile below points at
+    nothing and may do nothing.
+
+    Note: mod_httapi's file cache does not verify the server's certificate
+    (fetch_cache_data turns CURLOPT_SSL_VERIFYPEER off for https and has no
+    setting to turn it on). It only ever fetches a recording to play; keep
+    it that way.
+  -->
+  <settings>
+    <param name="debug" value="false"/>
+    <!-- A copy of every file played stays in the storage_dir/http_file_cache
+         (<md5 of the url>.<ext> plus a .meta file holding the whole url),
+         and file-cache-ttl does NOT delete it: it only sets when a copy is
+         fetched again. Every drop link is new, so every drop would leave a
+         new copy, in the container's writable layer (storage_dir is not
+         under a volume). What deletes it is the response's Cache-Control:
+         no-store or no-cache makes mod_httapi unlink both files when
+         playback ends (del_on_close). The CRM signs drop links with
+         response-cache-control=no-store, so S3 sends exactly that.
+         Never set abs-file-cache-ttl: with it mod_httapi ignores the
+         response's Cache-Control, and nothing is ever deleted again.
+         Lab: section 4, be17https, http_file_cache checked after each row. -->
+    <param name="file-cache-ttl" value="300"/>
+    <param name="file-not-found-expires" value="0"/>
+  </settings>
+  <profiles>
+    <profile name="default">
+      <permissions>
+        <permission name="set-params" value="false"/>
+        <permission name="set-vars" value="false"/>
+        <permission name="get-vars" value="false"/>
+        <permission name="extended-data" value="false"/>
+        <permission name="execute-apps" value="false"/>
+        <permission name="expand-vars-in-tag-body" value="false"/>
+        <permission name="dial" value="false"/>
+        <permission name="conference" value="false"/>
+      </permissions>
+      <params>
+        <param name="gateway-url" value="http://127.0.0.1:9/httapi-is-not-used"/>
+        <param name="timeout" value="10"/>
+        <param name="connect-timeout" value="5"/>
+      </params>
+    </profile>
+  </profiles>
+</configuration>
