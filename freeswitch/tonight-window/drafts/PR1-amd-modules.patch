diff --git a/scripts/campaign_amd.lua b/scripts/campaign_amd.lua
new file mode 100644
index 0000000..76e9d6a
--- /dev/null
+++ b/scripts/campaign_amd.lua
@@ -0,0 +1,225 @@
+--[[
+campaign_amd.lua - the two detectors on a campaign dialer call, and what (if
+anything) they decide. Runs on the CUSTOMER leg the moment it answers.
+
+TWO MODES. The CRM picks one per company at originate (channel variable
+conexus_amd_mode; ConexusCRM-BE dialer_automations.amd_enabled):
+
+  pilot (the default; anything but "gate")  Eric's approved pilot mode,
+      2026-10-24. The agent joins as soon as the call is answered; mod_amd
+      runs only to LOG its verdict (nothing waits on it); a recorded message
+      plays only from the agent's "drop voicemail" button, which the CRM
+      refuses until mod_avmd has heard a beep (avmd_detect=TRUE), and which
+      then plays after the beep.
+  gate  "AMD gates the agent", for later, once the pilot's numbers allow it
+      (docs freeswitch/lab/research/AMD-STRATEGY.md section 7). Only on a
+      customer-first call (see below); the decision table further down.
+
+How the CRM starts it:
+  - agent-first (today's campaign calls: the agent's phone is called first
+    and the customer is bridged to it, ConexusCRM-BE originate.ts, BE-12):
+        customer leg: execute_on_answer_campaign_amd=lua::campaign_amd.lua
+    The agent is already on the line, so nothing can be held back: this leg
+    always runs as PILOT, whatever conexus_amd_mode says. ("::" queues the
+    script on the leg's own thread, as uuid_broadcast does; it returns at
+    once and the call stays bridged.)
+  - customer-first (not built in the CRM; the lab's flows):
+        originate {...}<customer> 'lua:campaign_amd.lua' inline
+    pilot: an agent at once ("connect", the leg parked for the CRM to
+    bridge); gate: the decision table.
+
+Two detectors, each used for what it is good at:
+  - mod_amd decides WHO GETS AN AGENT (gate mode only; in pilot it is logged).
+  - the mod_avmd BEEP alone decides WHETHER A RECORDING PLAYS. No beep, no
+    recording, ever, in either mode.
+
+Gate mode's decision table, whatever happens first:
+  beep, before an agent is joined  -> drop allowed: wait for the beep to end,
+                                      play, hang up ("drop"); otherwise hang up
+                                      as a machine ("machine_hangup")
+  HUMAN or NOTSURE                 -> an agent now ("connect")
+  MACHINE, drop allowed            -> hold for a beep until HOLD_MS after
+                                      answer; beep -> as above; none -> an
+                                      agent ("connect_late"), never a recording
+  MACHINE, drop not allowed        -> hang up ("machine_hangup"). Not an
+                                      abandoned call if it really was a machine
+                                      (FCC 03-153 fn. 538); the CRM counts it as
+                                      one unless a beep proves it was
+  no verdict by NO_VERDICT_MS      -> an agent ("connect"): mod_amd always ends
+                                      by total_analysis_time, so this is only a
+                                      fail-safe for an AMD that never started
+  they hang up first               -> nothing ("cancel")
+
+So a person can only ever hear a recording if mod_avmd hears a beep that is
+not there; neither mod_amd nor the agent's button can play one by itself.
+
+Channel variables, set by the CRM at originate (nothing comes from the far
+end):
+  conexus_amd_mode     "gate" for gate mode; anything else is pilot.
+  conexus_drop_ok      gate mode: "true" when this call may get a recorded
+                       message (BE-17's dropAllowed). Anything else: never plays.
+  conexus_drop_target  gate mode: what to play (BE-17's playback link).
+
+Every decision is reported as a CUSTOM event, subclass conexus::amd, with
+Unique-ID, decision, mode, amd_result, amd_cause, verdict_ms and beep_ms (from
+answer), and which detectors started (avmd, amd: "started" or "missing").
+In pilot mode mod_amd's verdict is reported when it comes, by mod_amd itself
+(its amd_on_human / amd_on_machine / amd_on_notsure hooks fire a conexus::amd
+event, decision "verdict"): its own amd::info event has no Event-Name, and
+the CRM's ESL router drops events without one (lab NOTES item 5). avmd::beep
+is a normal CUSTOM event. The verdict also stays on the channel (amd_result,
+amd_cause), so it is in the CDR.
+
+A missing module never takes the call down: FreeSWITCH hangs up a channel
+that runs an application it does not know, so each detector is started only
+if its module is loaded (a call then just has no beep on record: the drop
+button stays refused, the safe side).
+]]
+
+local HOLD_MS = 30000        -- MACHINE: how long after answer to wait for a beep
+local NO_VERDICT_MS = 15000  -- total_analysis_time (12000) + room; fail-safe only
+local STEP_MS = 20           -- one media frame
+-- After the beep event: the line quiet for 50 frames, then FreeSWITCH's own
+-- 0.5 s countdown; 3.5 s at most after the event. The beep event arrives
+-- about 0.2 s into the beep. 400 is on wait_for_silence's own scale (it
+-- reads every other sample of a mono frame and divides by all 160: about
+-- half the level mod_amd's 640 means), so a mailbox beep resets the count
+-- and the message starts about 1.5 s after the beep ends; the research
+-- model put every beep clip in every variant after the beep (216/216,
+-- 0.28-1.52 s after it ended). The same threshold BE-17 and RUNBOOK F3 use.
+local DROP_WAIT = "400 50 0 3500"
+
+local s = session
+if not s or not s:ready() then return end
+local uuid = s:get_uuid()
+
+local function var(name)
+  local v = s:getVariable(name)
+  if v == nil or v == "" or v == "_undef_" then return nil end
+  return v
+end
+
+-- Time is measured on the wall clock from the moment the leg answered, not
+-- by counting sleeps: a session:sleep(20) takes 20-40 ms of wall time, and
+-- counted that way a 30 s hold ran 47 s in the lab. LuaSocket (PR2) has a
+-- sub-millisecond clock; answer_uepoch is when FreeSWITCH saw the answer.
+local have_socket, socket = pcall(require, "socket")
+local now = have_socket and socket.gettime or os.time
+local answered = (tonumber(var("answer_uepoch") or "") or 0) / 1e6
+if answered <= 0 then answered = now() end
+local function since_answer() return math.floor((now() - answered) * 1000 + 0.5) end
+
+-- Placed from another leg (originator: the agent's leg, agent-first) means
+-- an agent is already on the line: nothing to gate, so pilot.
+local bridged = var("originator") ~= nil
+local requested = var("conexus_amd_mode") == "gate" and "gate" or "pilot"
+local mode = (requested == "gate" and not bridged) and "gate" or "pilot"
+
+local drop_target = var("conexus_drop_target")
+local drop_ok = mode == "gate" and var("conexus_drop_ok") == "true" and drop_target ~= nil
+
+local verdict_ms, beep_ms = nil, nil
+local started = {}
+
+local function tell(decision, extra)
+  local e = freeswitch.Event("CUSTOM", "conexus::amd")
+  e:addHeader("Unique-ID", uuid)
+  e:addHeader("decision", decision)
+  e:addHeader("mode", mode)
+  e:addHeader("requested_mode", requested)
+  e:addHeader("avmd", started.avmd or "")
+  e:addHeader("amd", started.amd or "")
+  e:addHeader("amd_result", var("amd_result") or "")
+  e:addHeader("amd_cause", var("amd_cause") or "")
+  e:addHeader("verdict_ms", verdict_ms and tostring(verdict_ms) or "")
+  e:addHeader("beep_ms", beep_ms and tostring(beep_ms) or "")
+  for k, v in pairs(extra or {}) do e:addHeader(k, v) end
+  e:fire()
+end
+
+local function loaded(module)
+  local ok, out = pcall(function() return freeswitch.API():execute("module_exists", module) end)
+  return ok and tostring(out or ""):match("^%s*true") ~= nil
+end
+
+-- Start a detector (a media bug: returns at once) if its module is there.
+local function start(name, module, app)
+  if loaded(module) then
+    s:execute(app)
+    started[name] = "started"
+  else
+    started[name] = "missing"
+    freeswitch.consoleLog("WARNING", "campaign_amd: " .. module .. " not loaded; " .. app .. " not started on " .. uuid .. "\n")
+  end
+end
+
+-- An agent now: hand the leg to the CRM, parked, still listening.
+local function connect(decision)
+  tell(decision)
+  s:setAutoHangup(false)
+  s:execute("park")
+end
+
+-- A beep is on record: the voicemail path (gate mode only).
+local function mailbox()
+  if not drop_ok then
+    tell("machine_hangup")
+    s:hangup("NORMAL_CLEARING")
+    return
+  end
+  tell("drop")
+  s:execute("wait_for_silence", DROP_WAIT)
+  if not s:ready() then return end
+  s:execute("playback", drop_target)
+  -- what playback said ("FILE PLAYED" or why not): the CRM settles the
+  -- drop on this, not on the transfer having been accepted
+  tell("drop_done", { playback = var("current_application_response") or "" })
+  s:hangup("NORMAL_CLEARING")
+end
+
+start("avmd", "mod_avmd", "avmd_start")   -- beep listener
+if mode == "pilot" then
+  -- mod_amd reports its own verdict when it comes; nothing waits on it.
+  -- (Set before amd starts. Expanded when the verdict fires.)
+  local hook = "event:Event-Name=CUSTOM,Event-Subclass=conexus::amd,decision=verdict,mode=pilot,"
+    .. "requested_mode=" .. requested .. ",amd_result=${amd_result},amd_cause=${amd_cause}"
+  s:setVariable("amd_on_human", hook)
+  s:setVariable("amd_on_machine", hook)
+  s:setVariable("amd_on_notsure", hook)
+end
+start("amd", "mod_amd", "amd")
+
+if mode == "pilot" then
+  if bridged then
+    -- agent-first: the agent is on the line already. Report and leave the
+    -- call alone (no auto hang-up when the script ends: that would end it).
+    tell("connect", { bridged = "true" })
+    s:setAutoHangup(false)
+    return
+  end
+  return connect("connect")
+end
+
+while s:ready() do
+  local ms = since_answer()
+  if var("avmd_detect") == "TRUE" then
+    beep_ms = beep_ms or ms
+    return mailbox()
+  end
+  local v = var("amd_result")
+  if v and not verdict_ms then verdict_ms = ms end
+  if v == "HUMAN" or v == "NOTSURE" then return connect("connect") end
+  if v == "MACHINE" then
+    if not drop_ok then
+      tell("machine_hangup")
+      s:hangup("NORMAL_CLEARING")
+      return
+    end
+    if ms >= HOLD_MS then return connect("connect_late") end
+  elseif not v and ms >= NO_VERDICT_MS then
+    return connect("connect")
+  end
+  s:sleep(STEP_MS)
+end
+-- they hung up before anything was decided
+tell("cancel")
