diff --git a/docker/Dockerfile b/docker/Dockerfile
index e778b3a..eb1d5ad 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -16,6 +16,12 @@ ARG SPANDSP_SHA=7977601
 ARG DEEPGRAM_MODULES_REPO=https://github.com/deepgram/freeswitch_modules.git
 ARG DEEPGRAM_MODULES_SHA=ec6940e3147afe64e4dc07566b7cba99531020b4
 
+# Out-of-tree source for mod_amd (human-or-machine answering-machine detection,
+# a port of Asterisk's app_amd; CC0 licence). Not part of FreeSWITCH 1.10.12.
+# Pinned to the last commit that changed the module's code; bump intentionally.
+ARG AMD_MODULE_REPO=https://github.com/webitel/mod_amd.git
+ARG AMD_MODULE_SHA=52e6bc6930b10df67a572253e4c5af7d212ecf9f
+
 ENV DEBIAN_FRONTEND=noninteractive
 
 # Minimum build deps for FreeSWITCH with its default module set.
@@ -56,6 +62,8 @@ RUN git clone https://github.com/freeswitch/spandsp /usr/src/libs/spandsp \
     && git -C /usr/src/libs/spandsp checkout ${SPANDSP_SHA}
 RUN git clone ${DEEPGRAM_MODULES_REPO} /usr/src/libs/deepgram_modules \
     && git -C /usr/src/libs/deepgram_modules checkout ${DEEPGRAM_MODULES_SHA}
+RUN git clone ${AMD_MODULE_REPO} /usr/src/libs/mod_amd \
+    && git -C /usr/src/libs/mod_amd checkout ${AMD_MODULE_SHA}
 
 # Build SignalWire deps (order matters: libks first, then sofia-sip/spandsp).
 RUN cd /usr/src/libs/libks && cmake . -DCMAKE_INSTALL_PREFIX=/usr -DWITH_LIBBACKTRACE=1 && make -j"$(nproc)" install
@@ -75,6 +83,13 @@ RUN cp -r /usr/src/libs/deepgram_modules/modules/mod_deepgram_transcribe \
     && sed -i 's#src/mod/applications/mod_abstraction/Makefile#src/mod/applications/mod_deepgram_transcribe/Makefile\n\t\t&#' configure.ac \
     && grep -q 'mod_deepgram_transcribe/Makefile' configure.ac
 
+# Same graft for mod_amd (answering-machine detection). Same tripwire.
+RUN mkdir -p /usr/src/freeswitch/src/mod/applications/mod_amd \
+    && cp /usr/src/libs/mod_amd/mod_amd.c /usr/src/libs/mod_amd/Makefile.am \
+          /usr/src/freeswitch/src/mod/applications/mod_amd/ \
+    && sed -i 's#src/mod/applications/mod_abstraction/Makefile#src/mod/applications/mod_amd/Makefile\n\t\t&#' configure.ac \
+    && grep -q 'mod_amd/Makefile' configure.ac
+
 RUN ./bootstrap.sh -j
 
 # Use prod's modules.conf directly instead of sed-juggling defaults.
