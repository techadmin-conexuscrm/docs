diff --git a/scripts/secure_payment.lua b/scripts/secure_payment.lua
new file mode 100644
index 0000000..6969d38
--- /dev/null
+++ b/scripts/secure_payment.lua
@@ -0,0 +1,962 @@
+--[[
+  secure_payment.lua: silent secure keypad entry, customer leg only.
+
+  The CRM (POST /v1/telephony/secure-payment/start) has already:
+    1. masked every recording on the call and confirmed +OK,
+    2. set hangup_after_bridge=false / park_after_bridge=true on the agent leg,
+    3. set secure_payment_session / secure_payment_call_id /
+       secure_payment_agent_uuid on THIS channel (ids only),
+    4. uuid_transfer'd THIS channel (the customer) to the secure_payment
+       extension, which runs this script.
+  The agent leg is parked: there is no audio path between customer and agent,
+  so the agent hears no voice, no RFC 2833 events and no in-band tones, and no
+  masking beep is needed (or played).
+
+  This script:
+    - collects card number, expiry, CVV and ZIP with session:getDigits, one
+      digit at a time (never play_and_get_digits / read with a variable name),
+      so no digit is ever stored in a channel variable;
+    - runs with sensitive_dtmf=true on this channel (the dialplan sets it
+      first; this script sets it again before the first key). Without it
+      FreeSWITCH itself logs every key at INFO ("RECV DTMF"), fires a DTMF
+      event per key and joins them all into digits_dialed, which goes to the
+      json CDR and CHANNEL_HANGUP_COMPLETE;
+    - '*' at any prompt returns the customer to the agent;
+    - fires CUSTOM secure_payment::progress events with field names, counts
+      and states only, never digits;
+    - posts the card over HTTPS straight from Lua (LuaSec) to the CRM's
+      tokenize endpoint, which hands it to the gateway's vault. It does NOT use
+      mod_curl's `curl` API: every API call fires an API event carrying its
+      full argument line (API-Command-Argument), so the card would reach any
+      ESL client subscribed to API or ALL events;
+    - always reconnects the customer to the agent at the end (pcall), and the
+      CRM's watchdog does it too if this script never gets there. The final
+      event goes after the bridge, not before (see reconnect).
+
+  Requires on the FreeSWITCH host: LuaSec + LuaSocket for the Lua version
+  mod_lua is built with (e.g. Debian: lua-sec, lua-socket), the CA bundle at
+  CA_FILE, prompts in the prompt directory, the secret file and the TLS pins
+  (below). The API's certificate is checked by name and pin before anything
+  is sent; nothing is sent over plain HTTP.
+
+  Lua strings can't be wiped: setting them to nil only ends their reachable
+  lifetime. Core dumps must be off and swap encrypted on this host.
+  See docs/dialer/secure-payment-verification.md.
+--]]
+
+local api = freeswitch.API()
+
+-- ── configuration (no secrets in this file) ─────────────────────────────────
+-- vars.xml:
+--   <X-PRE-PROCESS cmd="set" data="crm_secure_payment_tokenize_url=https://api.example.com/api/v1/telephony/secure-payment/tokenize"/>
+--   <X-PRE-PROCESS cmd="set" data="crm_secure_payment_secret_file=/etc/freeswitch/secure_payment.secret"/>
+--   <X-PRE-PROCESS cmd="set" data="crm_secure_payment_tls_pins=<sha256 of a cert in the API's chain>[,...]"/>
+-- The secret file holds TELEPHONY_PAYMENT_SECRET, owner freeswitch, mode 0400.
+local TOKENIZE_URL = freeswitch.getGlobalVariable("crm_secure_payment_tokenize_url")
+local SECRET_FILE  = freeswitch.getGlobalVariable("crm_secure_payment_secret_file")
+                     or "/etc/freeswitch/secure_payment.secret"
+local PROMPT_DIR   = freeswitch.getGlobalVariable("crm_secure_payment_prompt_dir")
+                     or "/usr/share/freeswitch/sounds/secure_payment"
+local CA_FILE      = freeswitch.getGlobalVariable("crm_secure_payment_ca_file")
+                     or "/etc/ssl/certs/ca-certificates.crt"
+
+local SESSION_ID    = session:getVariable("secure_payment_session")
+local CALL_ID       = session:getVariable("secure_payment_call_id")
+local AGENT_UUID    = session:getVariable("secure_payment_agent_uuid")
+local CUSTOMER_UUID = session:get_uuid()
+
+local MAX_ATTEMPTS     = 3     -- per field, and card attempts at the gateway
+local FIRST_DIGIT_MS   = 10000
+local INTER_DIGIT_MS   = 5000
+local HTTP_TIMEOUT_S   = 15    -- the API gives the gateway 10 s (TOKENIZE_TIMEOUT_MS)
+
+local finished = false         -- a final event has been sent
+local hung_up = false
+local transferred = false      -- moved out of secure_payment by someone else
+local reconnected = false      -- this script put the customer back with the agent
+
+-- ── logging: never a digit ──────────────────────────────────────────────────
+local function log(level, message)
+  freeswitch.consoleLog(level, string.format("[secure_payment call=%s] %s\n",
+    tostring(CALL_ID), message))
+end
+
+-- ── progress events: field, counts, state. Never digits. ───────────────────
+local function progress(state, field, entered, of, attempt, reason)
+  local e = freeswitch.Event("CUSTOM", "secure_payment::progress")
+  e:addHeader("Secure-Payment-Call-Id", CALL_ID or "")
+  e:addHeader("Secure-Payment-Session", SESSION_ID or "")
+  e:addHeader("Secure-Payment-State", state)
+  if field then e:addHeader("Secure-Payment-Field", field) end
+  if entered then e:addHeader("Secure-Payment-Entered", tostring(entered)) end
+  if of then e:addHeader("Secure-Payment-Of", tostring(of)) end
+  if attempt then e:addHeader("Secure-Payment-Attempt", tostring(attempt)) end
+  if reason then e:addHeader("Secure-Payment-Reason", reason) end
+  e:fire()
+end
+
+-- The final event. State: completed | cancelled | failed | customer_hangup
+-- (what the CRM acts on). A "failed" also carries a coarse reason, so the
+-- CRM can tell a system fault from a customer who gave up:
+--   setup      config, secret, pins or libraries wrong on this box
+--   transport  API unreachable, TLS check failed, connection dropped
+--   declined   the gateway refused the card (last try, or not retryable)
+--   timeout    no key in time          invalid  3 invalid entries
+--   deadline   out of time before the CRM's 3-minute watchdog
+--   hangup     the channel went away   error    unexpected script error
+-- A customer_hangup sent because someone else moved this leg out of
+-- secure_payment carries the reason "transfer" (see the hook below).
+-- Never a digit.
+local function final(state, reason)
+  if finished then return end
+  finished = true
+  progress(state, nil, nil, nil, nil, state == "failed" and (reason or "error") or reason)
+end
+
+-- mod_lua calls this once, on hang-up (status "hangup") or when the channel
+-- is sent back to routing (status "transfer"), e.g. by another uuid_transfer
+-- of this leg such as a voicemail drop.
+-- Hang-up: tell the CRM, which ends the agent leg so the call settles
+-- normally ("Customer hung up during payment").
+-- Transfer: the customer is somewhere else now, and is never bridged back
+-- from here. For the agent it is the same as a hang-up: they are parked in
+-- silence on nobody. So it is reported as customer_hangup (reason
+-- "transfer"), the one final state on which the CRM ends the parked agent
+-- leg. Any other state would be wrong: the CRM takes completed, cancelled
+-- and failed alike as "Lua put the customer back itself", skips its own
+-- re-bridge and leaves the agent parked on a dead line, told the customer
+-- is back. And when the transferred leg is hung up before the CRM gets to
+-- this event (a voicemail drop does that), the CRM already ends the agent
+-- leg as a hang-up, so both orders now end the same way.
+function secure_payment_on_hangup(s, status, arg)
+  if status == "transfer" then
+    transferred = true
+    final("customer_hangup", "transfer")
+    return
+  end
+  hung_up = true
+  final("customer_hangup")
+end
+session:setHangupHook("secure_payment_on_hangup")
+
+local function play(name)
+  if session:ready() then session:streamFile(PROMPT_DIR .. "/" .. name) end
+end
+
+-- ── time limit ──────────────────────────────────────────────────────────────
+-- The CRM's watchdog ends the entry 180 s after it started it
+-- (SECURE_ENTRY_MAX_MS): it bridges the customer back with no prompt and
+-- unmasks the recording, and a tokenize still in flight is refused. So the
+-- script takes no key after KEY_DEADLINE_S from its own start, which leaves
+-- time for the last tokenize (the API gives the gateway 10 s) and the closing
+-- prompts, and starts no new card attempt with less than MIN_PASS_S to go
+-- (one pass at a person's pace is about a minute).
+local KEY_DEADLINE_S = 150
+local MIN_PASS_S     = 55
+local key_deadline = os.time() + KEY_DEADLINE_S
+local function seconds_left() return key_deadline - os.time() end
+
+-- ── validation ──────────────────────────────────────────────────────────────
+local function luhn_valid(number)
+  local sum, alternate = 0, false
+  for i = #number, 1, -1 do
+    local digit = tonumber(number:sub(i, i))
+    if not digit then return false end
+    if alternate then
+      digit = digit * 2
+      if digit > 9 then digit = digit - 9 end
+    end
+    sum = sum + digit
+    alternate = not alternate
+  end
+  return sum % 10 == 0
+end
+
+local function valid_pan(d) return #d >= 13 and #d <= 19 and luhn_valid(d) end
+
+local function valid_expiry(d)
+  if not d:match("^%d%d%d%d$") then return false end
+  local month, year = tonumber(d:sub(1, 2)), tonumber(d:sub(3, 4))
+  if month < 1 or month > 12 then return false end
+  local now = os.date("*t")
+  local cy, cm = now.year % 100, now.month
+  if year < cy or (year == cy and month < cm) then return false end
+  return year <= cy + 20
+end
+
+local function is_amex(pan) return pan:sub(1, 2) == "34" or pan:sub(1, 2) == "37" end
+
+-- A card number keyed so far (one digit per entry) that is already whole:
+-- as long as its first digits say - 15 for American Express (34, 37), 16
+-- for Visa (4), Mastercard (51-55, 2221-2720) and Discover (6011, 644-649,
+-- 65) - and passing the Luhn check. The card prompt asks for "#" only on a
+-- card shorter than sixteen digits, so without this a 16-digit card sat
+-- through the 5 s wait for a 17th digit, and an expiry keyed into that
+-- silence became card digits 17-19. Other prefixes (UnionPay, Maestro, JCB,
+-- Diners) don't fix a length and still end on "#", the wait or 19 digits;
+-- so does a 19-digit Visa or Discover whose first 16 digits fail Luhn. (One
+-- whose first 16 digits pass - about 1 in 10 of those rare cards - is taken
+-- as 16 digits and declined: the agent takes it another way.)
+local function pan_complete(digits, count)
+  if count ~= 15 and count ~= 16 then return false end
+  local n = 0
+  for i = 1, 4 do n = n * 10 + tonumber(digits[i]) end
+  local two, three = math.floor(n / 100), math.floor(n / 10)
+  local length
+  if two == 34 or two == 37 then length = 15
+  elseif math.floor(n / 1000) == 4 or (two >= 51 and two <= 55) or (n >= 2221 and n <= 2720)
+      or n == 6011 or (three >= 644 and three <= 649) or two == 65 then length = 16 end
+  if count ~= length then return false end
+  local sum = 0
+  for i = count, 1, -1 do
+    local d = tonumber(digits[i])
+    if (count - i) % 2 == 1 then d = d * 2; if d > 9 then d = d - 9 end end
+    sum = sum + d
+  end
+  return sum % 10 == 0
+end
+
+-- ── collection: one digit at a time, nothing stored on the channel ──────────
+-- A prompt can't be interrupted, so a key pressed while one plays stays
+-- queued on the channel until the prompt ends. Two different things end up
+-- in that queue and they must not be treated the same way:
+--
+--   * leftovers. The extra keys of the field or attempt before: a 4-digit
+--     year at the expiry prompt, a 4-digit code at the 3-digit prompt,
+--     expiry keys typed into the card's 5 s wait. Read as this field's
+--     first digits they make it wrong, and every retry after it.
+--   * type-ahead. Someone who has done this before and keys their card over
+--     the prompt rather than waiting for it to end. Those ARE this field's
+--     digits. Dropping them leaves a short entry that times out in silence,
+--     or - worse - a 13-19 digit remainder that passes Luhn and is sent to
+--     the gateway as a card that is not theirs.
+--
+-- They are told apart by WHEN the key arrived, which is all the channel
+-- knows. drain_keys(DRAIN_MS) runs BEFORE the prompt and empties what is
+-- already queued: that can only be the previous field's. Anything pressed
+-- while the prompt plays is kept.
+--
+-- A field that fills up then reads what follows in the same burst
+-- (read_ahead, at most BURST_MS between keys), BEFORE the next prompt, and
+-- tells the two apart by HOW MANY keys come: no more than the field's own
+-- `surplus` (2 after the expiry: a 4-digit year; 1 after a 3-digit code: a
+-- 4-digit code) are its tail and dropped; one more than that and they are
+-- the next field typed ahead (the customer keys on without waiting for its
+-- prompt), so they are kept and become its first digits, and that field
+-- does not ask again for what it has already been given. The keys of a
+-- field that turns out invalid are never carried into its retry.
+--
+-- Not session:flushDigits(): FreeSWITCH copies each key it flushes into
+-- digits_dialed (json CDR, CHANNEL_HANGUP_COMPLETE), even with
+-- sensitive_dtmf set (switch_channel_flush_dtmf); a key read with getDigits
+-- is not. Returns "star" if one of the dropped keys was "*".
+local DRAIN_MS = 20      -- already on the channel
+local BURST_MS = 1000    -- still coming, at the end of a field that filled up
+local function drain_keys(window_ms)
+  for _ = 1, 64 do
+    if not session:ready() then return nil end
+    local d = session:getDigits(1, "", window_ms)
+    if d == nil or d == "" then return nil end
+    if d == "*" then return "star" end
+  end
+end
+
+-- After a field that filled up: the keys that follow in the same burst.
+-- Returns "star", or the digits when there are more than `surplus` of them
+-- (the next field typed ahead; reading stops at the first one over), or nil
+-- (nothing came, or only this field's own extra keys, which are dropped).
+-- Never past the key deadline.
+local function read_ahead(surplus)
+  local ahead = {}
+  for _ = 1, 64 do
+    if not session:ready() then return nil end
+    local left_ms = seconds_left() * 1000
+    if left_ms <= 0 then return nil end
+    local d = session:getDigits(1, "", math.min(BURST_MS, left_ms))
+    if d == nil or d == "" then return nil end
+    if d == "*" then return "star" end
+    if d:match("^%d$") then
+      ahead[#ahead + 1] = d
+      if #ahead > surplus then return ahead end
+    end
+  end
+  return nil
+end
+
+-- Returns digits and the next field's typed-ahead digits (or nil), or nil
+-- plus "star" | "timeout" | "deadline" | "hangup". `ahead`: this field's
+-- first digits, already typed (no prompt then). `surplus`: how many extra
+-- keys this field can be left with (see above).
+local function read_field(field, prompt, min_len, max_len, expected, attempt, ahead, surplus)
+  if not ahead then
+    if drain_keys(DRAIN_MS) == "star" then return nil, "star" end
+    play(prompt)
+  end
+  local digits, count = {}, 0
+  local filled = true
+  progress("collecting", field, 0, expected, attempt)
+  while count < max_len do
+    if not session:ready() then return nil, "hangup" end
+    local left_ms = seconds_left() * 1000
+    if left_ms <= 0 then return nil, "deadline" end
+    local wait_ms = count == 0 and FIRST_DIGIT_MS or INTER_DIGIT_MS
+    local d
+    if ahead and ahead[1] then
+      d = table.remove(ahead, 1)
+    else
+      d = session:getDigits(1, "", math.min(wait_ms, left_ms))
+    end
+    if d == nil or d == "" then
+      if count >= min_len then filled = false; break end
+      if seconds_left() <= 0 then return nil, "deadline" end
+      return nil, "timeout"
+    end
+    if d == "*" then return nil, "star" end
+    -- A "#" before any digit is the end of the previous fixed-length field
+    -- (it filled up before the customer pressed "#"). Ignore it rather than
+    -- end this field empty and play "not valid" (runbook B8).
+    if d == "#" and count > 0 then break end
+    if d:match("^%d$") then
+      count = count + 1
+      digits[count] = d
+      progress("collecting", field, count, expected, attempt)
+      if expected and count == expected and max_len == expected then break end
+      -- a whole card number ends here too, like a full fixed-length field
+      if field == "card" and pan_complete(digits, count) then break end
+    end
+  end
+  local value = table.concat(digits)
+  digits, ahead = nil, nil
+  -- The field filled up on a key, so the customer may still be pressing:
+  -- the tail of this field (a 4-digit code at the 3-digit prompt), dropped,
+  -- or the next field typed ahead, kept (see above). A field that ended on
+  -- its own inter-digit wait has nothing queued and nothing coming.
+  if filled then
+    local next_ahead = read_ahead(surplus or 0)
+    if next_ahead == "star" then return nil, "star" end
+    return value, next_ahead
+  end
+  return value
+end
+
+-- Prompts until valid, MAX_ATTEMPTS times. Returns value, nil, the next
+-- field's typed-ahead digits (or nil) | nil, reason. `ahead` goes to the
+-- first attempt only.
+-- A wrong entry and a pause ("timeout": no key for 10 s, or 5 s between
+-- keys, e.g. turning the card over for the code) each cost one attempt and
+-- the prompt is played again; "*", the deadline and a hang-up end the entry.
+-- Either way the customer is told before the prompt starts again: on a short
+-- entry or a pause the field has played nothing at all, and without this
+-- they would hear ten seconds of silence and then the same question.
+-- After the last attempt the reason is that attempt's: "invalid" or
+-- "timeout".
+local function collect(field, prompt, min_len, max_len, expected, validator, ahead, surplus)
+  local last = "invalid"
+  for attempt = 1, MAX_ATTEMPTS do
+    local value, why = read_field(field, prompt, min_len, max_len, expected, attempt, ahead, surplus)
+    ahead = nil
+    if value and validator(value) then
+      progress("field_ok", field, #value, expected, attempt)
+      return value, nil, why
+    end
+    if not value and why ~= "timeout" then return nil, why end
+    if value then why = nil end   -- an invalid entry: its typed-ahead keys go too
+    value = nil
+    last = why or "invalid"
+    progress("field_invalid", field, nil, expected, attempt, why)
+    log("info", field .. (why and " timed out" or " invalid") .. " on attempt " .. attempt)
+    if attempt < MAX_ATTEMPTS then
+      if seconds_left() <= 0 then return nil, "deadline" end
+      play("invalid_try_again.wav")
+    end
+  end
+  return nil, last
+end
+
+-- ── tokenize: HTTPS from Lua, never through the FreeSWITCH API ──────────────
+-- LuaSec's ssl.https checks the certificate chain but NOT that the
+-- certificate belongs to the host in the URL, so a certificate for any other
+-- name signed by any trusted CA would pass. The connection is therefore made
+-- by hand here and, before a single byte of the request is sent:
+--   1. TLS 1.2 or 1.3 only (no older protocol), SNI set to the URL host;
+--   2. the chain must verify against CA_FILE;
+--   3. the certificate's subjectAltName DNS names (or CN when it has none)
+--      must match the URL host;
+--   4. the leaf, or the certificate that signed it, must match a configured
+--      SHA-256 pin. A pin matched by a surplus certificate the peer merely
+--      sent along, or by one that only carries the issuer's name, does not
+--      count: the signature is checked (see pin_matches). No pin configured
+--      = no tokenize (fail closed).
+-- Pins: crm_secure_payment_tls_pins, a comma-separated list of SHA-256
+-- certificate fingerprints (hex, colons optional), read from the channel
+-- first, then the global variables. Pinning the issuing intermediate keeps
+-- working across certificate renewals; pinning the leaf is stricter but must
+-- be updated on every renewal, and tokenize fails closed the moment the
+-- certificate is renewed without it. See secure-payment-verification.md.
+
+local function read_secret()
+  local f = io.open(SECRET_FILE, "r")
+  if not f then return nil end
+  local secret = f:read("*l")
+  f:close()
+  if secret and #secret >= 32 and secret:match("^[%w%-_%.~+/=]+$") then return secret end
+  return nil
+end
+
+local function tls_pins()
+  local raw = session:getVariable("crm_secure_payment_tls_pins")
+    or freeswitch.getGlobalVariable("crm_secure_payment_tls_pins")
+  if not raw or raw == "" then return nil end
+  local pins, count = {}, 0
+  for item in raw:gmatch("[^,%s]+") do
+    local hex = item:gsub(":", ""):lower()
+    if #hex ~= 64 or not hex:match("^%x+$") then return nil end
+    pins[hex] = true
+    count = count + 1
+  end
+  if count == 0 then return nil end
+  return pins
+end
+
+-- https://host[:port]/path, host a DNS name (an IP can't be checked by name).
+local function parse_url(url)
+  local host, port, path = url:match("^https://([%w%.%-]+):(%d+)(/[%w%-%._~/]*)$")
+  if not host then
+    host, path = url:match("^https://([%w%.%-]+)(/[%w%-%._~/]*)$")
+    port = "443"
+  end
+  if not host or host:match("^[%d%.]+$") then return nil end
+  return host:lower(), tonumber(port), path
+end
+
+-- RFC 6125: exact match, or "*." as the whole left-most label covering
+-- exactly one label (never "*.com").
+local function name_matches(pattern, host)
+  pattern = pattern:lower()
+  if pattern == host then return true end
+  local suffix = pattern:match("^%*(%.[%w%-]+%.[%w%-%.]+)$")
+  if not suffix then return false end
+  local first, rest = host:match("^([%w%-]+)(%..+)$")
+  return first ~= nil and rest == suffix
+end
+
+local function certificate_names(cert)
+  local names = {}
+  local ok, exts = pcall(function() return cert:extensions() end)
+  if ok and type(exts) == "table" then
+    local san = exts["2.5.29.17"]
+    if type(san) == "table" and type(san.dNSName) == "table" then
+      for _, n in ipairs(san.dNSName) do names[#names + 1] = n end
+    end
+  end
+  if #names == 0 then
+    for _, entry in ipairs(cert:subject() or {}) do
+      if entry.name == "CN" or entry.oid == "2.5.4.3" then names[#names + 1] = entry.value end
+    end
+  end
+  return names
+end
+
+local function digest_hex(cert)
+  local ok, d = pcall(function() return cert:digest("sha256") end)
+  if not ok or type(d) ~= "string" then return nil end
+  return d:gsub(":", ""):lower()
+end
+
+-- A certificate's subject or issuer as one comparable string.
+local function dn_string(cert, which)
+  local ok, dn = pcall(function() return cert[which](cert) end)
+  if not ok or type(dn) ~= "table" then return nil end
+  local parts = {}
+  for _, e in ipairs(dn) do
+    parts[#parts + 1] = tostring(e.oid or e.name or "?") .. "=" .. tostring(e.value)
+  end
+  if #parts == 0 then return nil end
+  return table.concat(parts, "/")
+end
+
+-- The pin must constrain the chain OpenSSL VERIFIED, not the certificates the
+-- peer chose to send. conn:getpeerchain() is SSL_get_peer_cert_chain: whatever
+-- was in the handshake. An attacker holding a certificate for this host
+-- mis-issued by any of the ~140 CAs in CA_FILE can append a copy of one of the
+-- pinned intermediates - public data, downloadable - as a surplus certificate.
+-- OpenSSL path-builds its own chain from the store and ignores the surplus one,
+-- the name check passes because the certificate is for the right host, and a
+-- pin matched anywhere in the presented chain would then match that surplus
+-- certificate. Mis-issuance by a trusted CA is the only thing pinning is here
+-- to stop, so matching that way constrains nothing.
+-- Names prove nothing either: a subject is text the issuing CA writes, so the
+-- same CA can name its own intermediate exactly like a pinned one (and copy
+-- its key identifiers), issue the leaf under that, and append the genuine
+-- pinned certificate. Accepted instead: the leaf itself is pinned, or a
+-- pinned certificate in the chain whose SIGNATURE is on the leaf. That is
+-- checked by OpenSSL, with LuaSec's x509 issued(): root:issued(leaf, pinned,
+-- ...) verifies the path leaf -> pinned -> ... -> root, every signature
+-- included, with only that root trusted (a root from CA_FILE: issued()
+-- accepts no intermediate as the anchor). Only the holder of the pinned
+-- certificate's key can make a leaf that passes.
+-- The path may need one certificate from the handshake above the pinned one:
+-- Let's Encrypt's YE*/YR* intermediates are issued by Root YE/YR, which are
+-- not in Debian's bundle, so the server sends Root YE cross-signed by ISRG
+-- Root X2 (api.tryconexus.com: leaf -> YE2 -> Root YE -> X2). Only
+-- certificates named exactly as the pinned one's issuer are passed along, so
+-- the leaf (whose issuer must be named exactly as the pinned certificate)
+-- has no other certificate OpenSSL could take as its issuer.
+
+-- The trusted roots in CA_FILE (PEM bundle), or nil.
+local function ca_roots()
+  local ok, x509 = pcall(require, "ssl.x509")
+  if not ok or type(x509) ~= "table" or not x509.load then return nil end
+  local f = io.open(CA_FILE, "r")
+  if not f then return nil end
+  local bundle = f:read("*a")
+  f:close()
+  local roots = {}
+  for pem in bundle:gmatch("%-%-%-%-%-BEGIN CERTIFICATE%-%-%-%-%-.-%-%-%-%-%-END CERTIFICATE%-%-%-%-%-") do
+    local okc, cert = pcall(x509.load, pem)
+    if okc and cert then roots[#roots + 1] = cert end
+  end
+  return roots
+end
+
+-- true when `cert`'s key signed `leaf`, on a path to a root in `roots`
+-- (directly, or through one certificate from `chain` named as `cert`'s
+-- issuer, e.g. a cross-signed root).
+local function signed_leaf(cert, leaf, chain, roots)
+  local name, up = dn_string(cert, "subject"), dn_string(cert, "issuer")
+  if not name or not up or name == up or dn_string(leaf, "issuer") ~= name then return false end
+  local above, tops = {}, { [up] = true }
+  for _, c in ipairs(chain) do
+    if c ~= leaf and dn_string(c, "subject") == up then
+      above[#above + 1] = c
+      local top = dn_string(c, "issuer")
+      if top and top ~= name then tops[top] = true end
+    end
+  end
+  for _, root in ipairs(roots) do
+    -- (the names only pick which roots to try; the signatures decide)
+    local rn = dn_string(root, "subject")
+    if rn and rn ~= name and tops[rn] then
+      local ok, yes = pcall(function() return root:issued(leaf, cert, (table.unpack or unpack)(above)) end)
+      if ok and yes == true then return true end
+    end
+  end
+  return false
+end
+
+local function pin_matches(leaf, chain, pins)
+  local d = digest_hex(leaf)
+  if d and pins[d] then return true end
+  local roots
+  for _, cert in ipairs(chain) do
+    local cd = digest_hex(cert)
+    if cd and pins[cd] then
+      roots = roots or ca_roots() or {}
+      if signed_leaf(cert, leaf, chain, roots) then return true end
+    end
+  end
+  return false
+end
+
+-- ── network I/O that never blocks the call ──────────────────────────────────
+-- Every socket below is non-blocking (timeout 0). While it waits on the
+-- network the script calls session:sleep(POLL_MS), which keeps reading this
+-- channel's media: the call recording keeps growing and RTP keeps flowing.
+-- (A blocking LuaSec read stops the channel reading media for as long as the
+-- API takes. The recording then stops growing, and upload-audio, which
+-- uploads and deletes any recording that has not grown for 10 s, uploads it
+-- mid-call: the rest of the call, the sale confirmation included, is lost.)
+-- One deadline covers a whole request, connect to last byte, and a
+-- connection is never read again after a failed read: after an unexpected
+-- EOF the next LuaSec read spins at 100% CPU and ignores every timeout, so
+-- the channel could never be freed, not even by uuid_kill (lab P11).
+local POLL_MS = 100
+
+local function wait_io(deadline)
+  if os.time() >= deadline then return false end
+  if session:ready() then
+    session:sleep(POLL_MS)
+  else
+    local ok, socket = pcall(require, "socket")
+    if ok and socket.sleep then socket.sleep(POLL_MS / 1000) end
+  end
+  return true
+end
+
+local function again(err) return err == "timeout" or err == "wantread" or err == "wantwrite" end
+
+-- Opens a TLS connection that passed every check above, or returns nil and
+-- a reason: "setup" (missing library, config or pin) or "transport"
+-- (unreachable, handshake, protocol, chain, name or pin failure, too slow).
+local function open_verified(host, port, pins, deadline)
+  local ok_socket, socket = pcall(require, "socket")
+  local ok_ssl, ssl = pcall(require, "ssl")
+  if not ok_socket or not ok_ssl then return nil, "setup", "LuaSec/LuaSocket not installed" end
+  local tcp = socket.tcp()
+  tcp:settimeout(0)
+  local connected, cerr = tcp:connect(host, port)
+  if not connected then
+    if not again(cerr) then tcp:close(); return nil, "transport", "connect failed" end
+    -- in progress: the socket turns writable once connected (or refused)
+    while true do
+      local _, writable = socket.select(nil, { tcp }, 0)
+      if writable and #writable > 0 then break end
+      if not wait_io(deadline) then tcp:close(); return nil, "transport", "connect timed out" end
+    end
+    if not tcp:getpeername() then tcp:close(); return nil, "transport", "connect failed" end
+  end
+  local conn = ssl.wrap(tcp, {
+    mode = "client",
+    protocol = "any",                                   -- TLS 1.2 and 1.3 ...
+    options = { "all", "no_sslv2", "no_sslv3", "no_tlsv1", "no_tlsv1_1" }, -- ... and nothing older
+    verify = { "peer", "fail_if_no_peer_cert" },
+    cafile = CA_FILE,
+  })
+  if not conn then tcp:close(); return nil, "transport", "tls setup failed" end
+  conn:sni(host)
+  conn:settimeout(0)
+  while true do
+    local done, herr = conn:dohandshake()
+    if done then break end
+    if not again(herr) then conn:close(); return nil, "transport", "handshake failed" end
+    if not wait_io(deadline) then conn:close(); return nil, "transport", "handshake timed out" end
+  end
+
+  local info = conn:info() or {}
+  if info.protocol ~= "TLSv1.2" and info.protocol ~= "TLSv1.3" then
+    conn:close(); return nil, "transport", "protocol not TLS 1.2/1.3"
+  end
+  if conn.getpeerverification and conn:getpeerverification() ~= true then
+    conn:close(); return nil, "transport", "chain not verified"
+  end
+  local leaf = conn:getpeercertificate()
+  if not leaf then conn:close(); return nil, "transport", "no certificate" end
+  local name_ok = false
+  for _, n in ipairs(certificate_names(leaf)) do
+    if name_matches(n, host) then name_ok = true; break end
+  end
+  if not name_ok then conn:close(); return nil, "transport", "certificate name does not match host" end
+  if not pin_matches(leaf, conn:getpeerchain() or {}, pins) then
+    conn:close(); return nil, "transport", "certificate pin mismatch"
+  end
+  return conn
+end
+
+local function send_all(conn, data, deadline)
+  local i = 1
+  while i <= #data do
+    local last, err, partial = conn:send(data, i)
+    if last then
+      i = last + 1
+    elseif again(err) then
+      i = (partial or (i - 1)) + 1
+      if not wait_io(deadline) then return false end
+    else
+      return false
+    end
+  end
+  return true
+end
+
+-- A reader for one connection: read(pattern) returns what LuaSocket's
+-- receive(pattern) would, or nil. The first nil is final: after it the
+-- connection is never read again.
+local function reader(conn, deadline)
+  local failed = false
+  return function(pattern)
+    if failed then return nil end
+    local acc = ""
+    while true do
+      local data, err, partial = conn:receive(pattern, acc)
+      if data then return data end
+      if not again(err) then failed = true; return nil end
+      acc = partial or acc
+      if not wait_io(deadline) then failed = true; return nil end
+    end
+  end
+end
+
+local function receive_body(read, headers)
+  local length = tonumber(headers["content-length"] or "")
+  if length then return read(length) end
+  if (headers["transfer-encoding"] or ""):lower():match("chunked") then
+    local parts = {}
+    while true do
+      local size_line = read("*l")
+      if not size_line then return nil end
+      local size = tonumber(size_line:match("^%x+") or "", 16)
+      if not size then return nil end
+      if size == 0 then break end
+      local part = read(size)
+      if not part then return nil end
+      parts[#parts + 1] = part
+      if not read("*l") then return nil end
+    end
+    return table.concat(parts)
+  end
+  return read("*a")
+end
+
+-- One POST on a fresh verified connection, within HTTP_TIMEOUT_S.
+-- Returns code, reply body | nil, kind ("setup" | "transport"), why.
+-- Never logs the request: it can hold a card.
+local function http_post(host, port, pins, path, secret, body)
+  local deadline = os.time() + HTTP_TIMEOUT_S
+  local conn, kind, why = open_verified(host, port, pins, deadline)
+  if not conn then return nil, kind, why end
+  local request = "POST " .. path .. " HTTP/1.1\r\n" ..
+    "Host: " .. host .. "\r\n" ..
+    "Content-Type: application/json\r\n" ..
+    "Content-Length: " .. #body .. "\r\n" ..
+    "X-Telephony-Secret: " .. secret .. "\r\n" ..
+    "Connection: close\r\n\r\n" .. body
+  local sent = send_all(conn, request, deadline)
+  request = nil
+  if not sent then conn:close(); return nil, "transport", "send failed" end
+  local read = reader(conn, deadline)
+  local status_line = read("*l")
+  local code = status_line and tonumber(status_line:match("^HTTP/1%.[01] (%d%d%d)") or "")
+  if not code then conn:close(); return nil, "transport", "reply unreadable" end
+  local headers = {}
+  while true do
+    local line = read("*l")
+    if not line then conn:close(); return nil, "transport", "reply unreadable" end
+    if line == "" then break end
+    local name, value = line:match("^([^:]+):%s*(.*)$")
+    if name then headers[name:lower()] = value end
+  end
+  local reply = receive_body(read, headers)
+  conn:close()
+  if not reply then return nil, "transport", "reply unreadable" end
+  return code, reply
+end
+
+-- Checked before the customer is asked for anything: the API's certificate,
+-- the app behind the TLS front end, and the shared secret. One request with
+-- the secret and the ids but no card: the API checks the secret first (401
+-- when it holds another one) and then the body, so the app itself answers
+-- 400 {"issues": [...]}. A 502 or 503 is the front end (Caddy) with the app
+-- down (a restart, a crash, the migration restart loop). Without this the
+-- customer keyed the whole card before any of that showed.
+local function probe_api()
+  local host, port, path = parse_url(TOKENIZE_URL or "")
+  local pins = tls_pins()
+  local secret = read_secret()
+  if not host then return false, "setup", "tokenize url not a https://hostname/path URL" end
+  if not pins then return false, "setup", "no valid crm_secure_payment_tls_pins" end
+  if not secret then return false, "setup", "secret file missing, unreadable or malformed" end
+  local code, reply, why = http_post(host, port, pins, path, secret,
+    '{"callId":"' .. CALL_ID .. '","sessionId":"' .. SESSION_ID .. '"}')
+  secret = nil
+  if not code then return false, reply, why end
+  if code == 401 or code == 403 then
+    return false, "setup", "the API refused the shared secret (http " .. code .. ")"
+  end
+  if code == 200 or (code == 400 and reply:match('"issues"')) then return true end
+  return false, "transport", "the API app is not answering (http " .. code .. ")"
+end
+
+-- Returns true, last4 | false, reason, retryable
+local function tokenize(pan, expiry, cvv, zip)
+  local host, port, path = parse_url(TOKENIZE_URL or "")
+  local pins = tls_pins()
+  local secret = read_secret()
+  if not host or not pins or not secret then
+    log("err", "tokenize not configured (url, pins or secret)")
+    return false, "setup", false
+  end
+  -- JSON by hand: every value is digits or a checked id, nothing to escape.
+  local body = '{"callId":"' .. CALL_ID .. '","sessionId":"' .. SESSION_ID ..
+    '","pan":"' .. pan .. '","expiry":"' .. expiry .. '","cvv":"' .. cvv ..
+    '","zip":"' .. zip .. '"}'
+  local code, reply, why = http_post(host, port, pins, path, secret, body)
+  body, secret = nil, nil
+  if not code then
+    log("err", "tokenize failed (" .. reply .. "): " .. why)
+    return false, reply, false
+  end
+  if code == 200 and reply:match('"success"%s*:%s*true') then
+    return true, reply:match('"last4"%s*:%s*"(%d%d%d%d)"')
+  end
+  local retryable = reply:match('"retryable"%s*:%s*true') ~= nil
+  log("info", "tokenize not saved, http " .. tostring(code))
+  return false, "declined", retryable
+end
+
+-- ── reconnect ───────────────────────────────────────────────────────────────
+-- Runs BEFORE the final event (state, reason) is sent, because the CRM acts
+-- on that event at once: it unmasks the recording and stops watching the
+-- call. Sent first, the customer would still be in here for the whole of
+-- "Returning you to your agent now", talking into an unmasked recording, and
+-- a hang-up (or a transfer) during that prompt would never be reported, so
+-- the agent's parked leg would never be ended. Sent after, such a hang-up
+-- reaches the CRM as customer_hangup (the hang-up hook sends it) and the agent
+-- leg is ended. Only when the agent's leg is already gone is the result sent
+-- first: the customer is hung up here, and the CRM, seeing the agent leg
+-- dead, ends the call as the agent's hang-up.
+local function reconnect(state, reason)
+  if hung_up or transferred or not session:ready() then return end
+  local agent_up = api:executeString("uuid_exists " .. AGENT_UUID)
+  if agent_up and agent_up:match("^true") then
+    play("returning_to_agent.wav")
+    if hung_up or transferred then return end
+    local r = api:executeString("uuid_bridge " .. CUSTOMER_UUID .. " " .. AGENT_UUID)
+    reconnected = r ~= nil and r:match("^%+OK") ~= nil
+  else
+    log("warning", "agent leg gone; ending the call")
+    final(state, reason)
+    play("agent_unavailable.wav")
+    session:hangup("NORMAL_CLEARING")
+  end
+end
+
+-- ── main ────────────────────────────────────────────────────────────────────
+local function preflight()
+  if not (SESSION_ID and SESSION_ID:match("^%x+$") and #SESSION_ID == 48) then
+    return false, "session id missing"
+  end
+  if not (CALL_ID and CALL_ID:match("^%x+%-%x+%-%x+%-%x+%-%x+$")) then
+    return false, "call id missing"
+  end
+  -- AGENT_UUID goes into API commands: strict uuid only.
+  if not (AGENT_UUID and AGENT_UUID:match("^%x+%-%x+%-%x+%-%x+%-%x+$")) then
+    return false, "agent uuid missing"
+  end
+  if not (TOKENIZE_URL and TOKENIZE_URL:match("^https://")) then
+    return false, "tokenize url missing or not https"
+  end
+  -- The secret is first needed at tokenize, after the customer has keyed
+  -- the whole card: check it now, before anything is asked for.
+  if not read_secret() then
+    return false, "secret file missing, unreadable or malformed"
+  end
+  return true
+end
+
+-- A field that ended without a value: "*" is the customer's choice, the
+-- rest are failures with their reason.
+local function field_failed(why)
+  if why == "star" then return "cancelled" end
+  if why == "deadline" then play("unable_to_process.wav") end
+  return "failed", why
+end
+
+local function main()
+  local ready, why = preflight()
+  if not ready then
+    log("err", "refusing to collect: " .. why)
+    play("unable_to_process.wav")
+    return "failed", "setup"
+  end
+  -- API reachable and its certificate right, before the customer keys
+  -- anything (sends nothing).
+  local reachable, kind, reason = probe_api()
+  if not reachable then
+    log("err", "tokenize endpoint not usable (" .. kind .. "): " .. reason)
+    play("unable_to_process.wav")
+    return "failed", kind
+  end
+  play("payment_intro.wav")   -- "...press star at any time to go back to your agent"
+
+  for card_attempt = 1, MAX_ATTEMPTS do
+    -- The last argument is how many extra keys each field can be left with
+    -- (a 4-digit year, a 4-digit code at the 3-digit prompt); more than that
+    -- after it fills up and they are the next field, typed ahead. Nothing
+    -- comes after the ZIP, so whatever follows it is dropped.
+    local pan, r1, ahead = collect("card", "enter_card_number.wav", 13, 19, 16, valid_pan, nil, 0)
+    if not pan then return field_failed(r1) end
+    local amex = is_amex(pan)
+
+    local expiry, r2
+    expiry, r2, ahead = collect("expiry", "enter_expiry.wav", 4, 4, 4, valid_expiry, ahead, 2)
+    if not expiry then pan = nil; return field_failed(r2) end
+
+    local cvv_len = amex and 4 or 3
+    local cvv, r3
+    cvv, r3, ahead = collect("cvv", amex and "enter_cvv_amex.wav" or "enter_cvv.wav",
+      cvv_len, cvv_len, cvv_len, function(d) return #d == cvv_len end, ahead, amex and 0 or 1)
+    if not cvv then pan, expiry = nil, nil; return field_failed(r3) end
+
+    local zip, r4
+    zip, r4, ahead = collect("zip", "enter_zip.wav", 5, 5, 5,
+      function(d) return d:match("^%d%d%d%d%d$") ~= nil end, ahead, math.huge)
+    ahead = nil
+    if not zip then pan, expiry, cvv = nil, nil, nil; return field_failed(r4) end
+
+    play("one_moment.wav")
+    local saved, reason, retryable = tokenize(pan, expiry, cvv, zip)
+    pan, expiry, cvv, zip = nil, nil, nil, nil
+    collectgarbage("collect")
+
+    if saved then
+      play("payment_captured.wav")
+      return "completed"
+    end
+    -- A transport or setup failure ends the entry at once: asking for the
+    -- whole card again can't help while the API or its certificate is wrong.
+    if reason == "transport" or reason == "setup" or not retryable or card_attempt == MAX_ATTEMPTS then
+      play("unable_to_process.wav")
+      return "failed", reason
+    end
+    if seconds_left() < MIN_PASS_S then
+      log("info", "card not accepted; no time left for another attempt")
+      play("unable_to_process.wav")
+      return "failed", "deadline"
+    end
+    play("card_not_accepted_try_again.wav")
+  end
+  return "failed", "declined"
+end
+
+-- No key may reach a log line, a DTMF event or digits_dialed (see the top
+-- of this file). The dialplan sets this before the script runs; set it again
+-- in case the channel got here another way. (A session_loglevel would not
+-- help: it can only make a channel more verbose than the global level.)
+-- A hold left by an earlier entry on this call (see the end of this file)
+-- must not lift protection in the middle of this one: cancel it first.
+local UNPROTECT_GROUP = "secure_payment_unprotect_" .. CUSTOMER_UUID
+local UNPROTECT_AFTER_S = 60
+api:executeString("sched_del " .. UNPROTECT_GROUP)
+session:setVariable("sensitive_dtmf", "true")
+
+local ok, result, reason = pcall(main)
+if not ok then
+  log("err", "unhandled error in secure_payment (details withheld)")
+  result, reason = "failed", "error"
+end
+if not hung_up and not transferred then
+  reconnect(result or "failed", reason)
+  final(result or "failed", reason)
+end
+-- The keys are the customer's again only once nothing of the card can
+-- still be coming. sensitive_dtmf left on for the rest of the call would
+-- make FreeSWITCH drop every key it passes across a bridge
+-- (switch_core_session_send_dtmf), so "press 1 to confirm" on an outside
+-- line the agent transfers them to would never be heard; turned off while
+-- the customer is still keying, every key becomes a "RECV DTMF" log line,
+-- a DTMF event and part of digits_dialed, which reaches the json CDR and
+-- CHANNEL_HANGUP - and scripts/event/esl_listener.py POSTs that to the CRM
+-- in full - and crosses the bridge to the agent's phone.
+-- 1. This script put the customer back itself: the last prompt has
+--    finished (returning_to_agent.wav plays for 3-4 s before the
+--    uuid_bridge, so a customer who was still keying when a field gave up
+--    has finished into that protected window). Unset now.
+-- 2. Anything else moved the leg away while the customer may have been in
+--    the middle of the card, with no prompt to stop them: the CRM's own
+--    uuid_bridge on an agent Cancel, an error or its watchdog, or a
+--    uuid_transfer. The keys still coming are card digits. Keep the
+--    protection and lift it UNPROTECT_AFTER_S later from the scheduler
+--    (uuid_setvar with no value unsets, in any channel state); a new entry
+--    on this call cancels that first (above). While it is held, keys the
+--    customer presses reach no one, which is the point.
+if not hung_up then
+  if reconnected then
+    api:executeString("uuid_setvar " .. CUSTOMER_UUID .. " sensitive_dtmf")
+  else
+    log("info", "left secure entry without the closing prompt; keypad protection held "
+      .. UNPROTECT_AFTER_S .. " s")
+    api:executeString(string.format("sched_api +%d %s uuid_setvar %s sensitive_dtmf",
+      UNPROTECT_AFTER_S, UNPROTECT_GROUP, CUSTOMER_UUID))
+  end
+end
+collectgarbage("collect")
